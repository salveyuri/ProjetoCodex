.npm-cache/
.next/
**/.next/
dist/
**/dist/
coverage/
**/coverage/

.env
.env.*
!.env.example
!**/.env.example

.git/
.gitignore
*.log

Contextos/
Notas/
CLAUDE.md
*.md

.vscode/
.idea/
