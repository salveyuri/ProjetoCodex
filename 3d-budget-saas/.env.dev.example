# Variaveis consumidas por docker-compose.dev.yml (ambiente de DEV/STAGING,
# ver Contextos/Ambientes.md "Ambiente de dev/staging"). Copie pra `.env` na
# pasta onde esse compose roda (uma pasta separada da de producao na mesma
# VPS) e preencha valores reais.
#
# Diferenca principal pro .env.example de producao: o banco e um Postgres
# LOCAL (container `postgres` do proprio docker-compose.dev.yml), nunca o
# Supabase de producao — por isso o POSTGRES_PASSWORD abaixo em vez de uma
# DATABASE_URL externa.
#
# NUNCA copie JWT_SECRET / ASAAS_WEBHOOK_TOKEN / ASAAS_API_KEY do .env de
# producao pra cá — gere/pegue valores NOVOS e diferentes pra este ambiente.

# --- Banco de dados (Postgres local, container proprio deste compose) ---
# Qualquer senha forte serve — e so usada entre os containers desta pilha,
# nunca exposta pra internet (porta 5433 amarrada a 127.0.0.1).
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# --- Backend ---
# Generate with: openssl rand -base64 48 — gere um NOVO, diferente do de producao.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Dominio deste ambiente (o subdominio de dev, com https).
CORS_ORIGIN=https://dev.pricify3d.com
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# Opcional: e-mail de um usuario ja registrado NESTE ambiente pra promover
# a ADMIN ao rodar `docker compose -f docker-compose.dev.yml run --rm
# backend npx prisma db seed`.
SEED_ADMIN_EMAIL=
# Origem publica deste ambiente — usada pra montar as callback URLs do
# checkout Asaas. TEM que ser https:// (o Asaas rejeita URLs http, mesma
# limitacao documentada pro dev local em Contextos/Ambientes.md).
APP_BASE_URL=https://dev.pricify3d.com
# SEMPRE sandbox neste ambiente — nunca "production" aqui.
ASAAS_ENV=sandbox
# Chave SANDBOX do Asaas (pode reusar a mesma que ja usa em dev local, ou
# gerar uma nova no painel sandbox do Asaas). Mesmo cuidado do .env.example
# de producao: chaves do Asaas comecam com "$" literal — sempre entre
# aspas simples aqui, ex.: ASAAS_API_KEY='$aact_hmlg_xxxxx...'
ASAAS_API_KEY=
# Segredo NOVO e diferente do de producao — gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Resend (e-mail transacional) — OBRIGATORIA aqui, apesar deste ser um
# ambiente de dev: o backend roda com NODE_ENV=production (de proposito,
# pra cookies seguros e respostas de erro discretas num dominio HTTPS
# publico de verdade) e resolveResendApiKey() em env.ts trava o boot sem
# essa chave sempre que NODE_ENV=production, independente do ASAAS_ENV.
# Pode reusar a mesma RESEND_API_KEY de producao — o Resend nao tem modo
# sandbox, e-mails de teste daqui saem de verdade (aceitavel, quem testa
# cadastro/reset de senha aqui e voce mesmo).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Pricify3D <system@pricify3d.com>"
# Prepende esse texto (com um espaço depois) no assunto de todo e-mail
# enviado por este ambiente — só existe em dev/staging, pra nunca
# confundir um envio de teste com um real na caixa de entrada. Vazio em
# producao (nunca definido no .env.example de lá).
EMAIL_SUBJECT_PREFIX="[DESENVOLVIMENTO]"
RESEND_WEBHOOK_SECRET=

# --- Frontend ---
# Precisa ser alcancavel pelo NAVEGADOR — o subdominio de dev.
NEXT_PUBLIC_API_URL=https://dev.pricify3d.com/api
