# Variables consumed by docker-compose.yml at the repo root. Copy this to
# `.env` (git-ignored) and fill in real values before running
# `docker compose up` for anything beyond quick local testing.
#
# This is separate from backend/.env and frontend/.env, which are only
# used for `npm run dev` (no Docker). Keep both in sync manually if you
# change something like JWT_EXPIRES_IN.
#
# This compose setup assumes an EXTERNAL managed Postgres (Supabase) —
# there is no local `postgres` service. See Contextos/Ambientes.md
# ("Producao — VPS + Supabase") for the full walkthrough.

# --- Banco de dados (Supabase) ---
# Painel do Supabase: Project Settings > Database > Connection string >
# "Session pooling" (porta 5432 via pooler — funciona como um Postgres
# normal, sem flags especiais no Prisma). Troque [YOUR-PASSWORD] pela
# senha do banco que voce definiu ao criar o projeto no Supabase.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Backend ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Deve ser o dominio REAL do frontend em producao, com https — nunca "*"
# (a API sempre manda credentials: true; ver SEC-007 em
# Contextos/Auditoria.md).
CORS_ORIGIN=https://seudominio.com
# 1 = confia no Nginx do host como unico hop de proxy na frente do backend
# (ver deploy/nginx.conf.example). So mudar se houver mais de um proxy/CDN
# na frente (ex. Cloudflare em modo proxy).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# Opcional: e-mail de um usuario pra promover a ADMIN ao rodar
# `docker compose run --rm backend npx prisma db seed`. O usuario precisa
# ja existir (se registre pelo site primeiro).
SEED_ADMIN_EMAIL=
# Origem publica do frontend, usada pra montar as callback URLs do
# checkout do Asaas. TEM que ser https:// — o Asaas rejeita URLs http.
APP_BASE_URL=https://seudominio.com
# Asaas (gateway de pagamento) — https://docs.asaas.com/. "sandbox" pra
# testar com dados/cartoes de teste, "production" pra cobranca real.
ASAAS_ENV=production
# ATENCAO: chaves do Asaas comecam com um "$" literal (ex.: $aact_prod_...).
# Sem aspas, o Docker Compose interpreta "$algumacoisa" no .env como
# referencia a OUTRA variavel de ambiente e zera o valor silenciosamente
# (quebra o build com "variable is not set" + "required variable ... is
# missing a value"). SEMPRE envolva o valor em aspas simples aqui:
# ASAAS_API_KEY='$aact_prod_xxxxx...'
ASAAS_API_KEY=
# Segredo que voce escolhe e tambem cadastra ao criar o webhook no painel
# do Asaas (verifica o header "asaas-access-token"). Gere com:
# openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Resend (e-mail transacional) — https://resend.com/docs. O dominio do
# remetente (pricify3d.com, hospedado no Zoho Mail) precisa estar
# verificado (SPF/DKIM) no painel do Resend antes de funcionar em producao.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Pricify3D <system@pricify3d.com>"
# Opcional (o app funciona sem isso, so nao preenche o status de entrega
# em /admin/email-templates). Rode "npm run resend:register-webhook" dentro
# de backend/ com o RESEND_API_KEY real ja configurado — ele cria o
# webhook e imprime o segredo pra colar aqui (Resend so mostra uma vez).
RESEND_WEBHOOK_SECRET=

# --- Frontend ---
# Precisa ser alcancavel pelo NAVEGADOR (nao so de dentro da rede Docker)
# — o dominio publico real em producao.
NEXT_PUBLIC_API_URL=https://seudominio.com/api
