# Segredos e credenciais — NUNCA versionar.
# Qualquer padrão sem "/" na frente casa em qualquer pasta do repo
# (backend/.env, frontend/.env, etc. já ficam cobertos por ".env*").
.env
.env.*
!.env.example
!**/.env.example
!.env.dev.example

# Chaves privadas, certificados TLS, tokens exportados
*.pem
*.key
*.ppk
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
id_ecdsa*
*.asc
*.gpg

# Dumps/backups de banco — nunca comitar um dump com dados reais.
# (Migrações do Prisma em backend/prisma/migrations/*.sql continuam
# rastreadas normalmente — esses padrões não pegam esse caminho.)
*.dump
*.sql.gz
*.pgdump
/backups/
/dumps/

# Dependências e build
node_modules/
.npm-cache/
.next/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# Artefatos de pacote
*.tgz
*.tar.gz

# Logs
*.log
npm-debug.log*
# Excecao: Chat.log e a memoria versionada do projeto (ver CLAUDE.md),
# nao um log de execucao — sempre deve ser rastreado pelo git.
!Contextos/Chat.log
!**/Contextos/Chat.log

# Playwright E2E output (frontend/e2e — specs themselves ARE tracked)
/frontend/playwright-report/
/frontend/test-results/
/frontend/blob-report/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
