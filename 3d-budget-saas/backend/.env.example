NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/3d_budget_saas?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# Set to the number of reverse-proxy hops (usually 1) once this API runs
# behind Nginx/another proxy in production. Leave unset/0 in local dev.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Public origin of the frontend. Used to build the Asaas checkout callback
# URLs (successUrl/cancelUrl/expiredUrl) that redirect the customer back
# after the hosted checkout page.
APP_BASE_URL=http://localhost:3000

# Asaas (payment gateway) — https://docs.asaas.com/
# "sandbox" uses api-sandbox.asaas.com (test data, test cards); "production"
# uses api.asaas.com (real charges). Required in production: ASAAS_API_KEY
# and ASAAS_WEBHOOK_TOKEN (the app fails fast on boot if missing).
ASAAS_ENV=sandbox
# ATENCAO: chaves do Asaas comecam com um "$" literal (ex.: $aact_hmlg_...).
# Envolva sempre em aspas (simples ou duplas) — ver o aviso completo no
# .env.example da raiz e Contextos/Conhecimento.md.
ASAAS_API_KEY=
# Shared secret you choose and also register when creating the webhook in
# the Asaas dashboard/API — Asaas echoes it back on every webhook call via
# the "asaas-access-token" header so we can verify authenticity.
ASAAS_WEBHOOK_TOKEN=

# Resend (transactional email) — https://resend.com/docs
# Required in production: RESEND_API_KEY (the app fails fast on boot if
# missing). Without a key in dev, emails are logged and skipped instead of
# sent — never blocks registration/webhook/quote flows.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Pricify3D <system@pricify3d.com>"
# Optional — not required to boot or to send email. Only unlocks the
# delivery-status column in /admin/email-templates (delivered/bounced/
# etc). Run `npm run resend:register-webhook` once RESEND_API_KEY and a
# public APP_BASE_URL are set; it prints the signing secret to paste here.
RESEND_WEBHOOK_SECRET=
