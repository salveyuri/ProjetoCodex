generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CheckoutStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

enum MachineType {
  FDM
  RESIN
}

enum MaterialType {
  FILAMENT
  RESIN
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model User {
  id                     String   @id @default(uuid()) @db.Uuid
  email                  String   @unique
  passwordHash           String   @map("password_hash")
  name                   String?
  role                   UserRole @default(USER)
  isActive               Boolean  @default(true) @map("is_active")
  notifyFinancialEmails  Boolean  @default(true) @map("notify_financial_emails")
  notifyQuoteEmails      Boolean  @default(true) @map("notify_quote_emails")
  notifyNewsletter       Boolean  @default(false) @map("notify_newsletter")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company             Company?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdByIp         String?   @map("created_by_ip")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Company {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  name                  String
  logoUrl               String?            @map("logo_url")
  defaultCurrency       String             @default("BRL") @map("default_currency")
  taxRate               Decimal            @default(0) @map("tax_rate") @db.Decimal(7, 4)
  planId                String             @map("plan_id") @db.Uuid
  subscriptionStatus    SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  asaasCustomerId       String?            @map("asaas_customer_id")
  asaasSubscriptionId   String?            @map("asaas_subscription_id")
  currentQuotesCount    Int                @default(0) @map("current_quotes_count")
  quoteUsagePeriodStart DateTime           @default(now()) @map("quote_usage_period_start")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  machines        Machine[]
  materials       Material[]
  pricingSettings PricingSettings?
  formulas        Formula[]
  quotes          Quote[]
  checkouts       Checkout[]
  payments        Payment[]

  @@index([planId])
  @@index([subscriptionStatus])
  @@index([planId, subscriptionStatus])
  @@map("companies")
}

model Plan {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  name                String
  description         String?
  price               Decimal      @default(0) @map("price") @db.Decimal(10, 2)
  currency            String       @default("BRL")
  billingCycle        BillingCycle @default(MONTHLY) @map("billing_cycle")
  maxMachinesAllowed  Int?         @map("max_machines_allowed")
  maxMaterialsAllowed Int?         @map("max_materials_allowed")
  maxQuotesPerMonth   Int?         @map("max_quotes_per_month")
  features            Json         @default("{\"customFormulas\":false,\"pdfExport\":false}")
  isActive            Boolean      @default(true) @map("is_active")
  isPublic            Boolean      @default(true) @map("is_public")
  displayOrder        Int          @default(0) @map("display_order")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  companies Company[]
  checkouts Checkout[]

  @@index([isActive, isPublic])
  @@map("plans")
}

model Checkout {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  planId          String         @map("plan_id") @db.Uuid
  asaasCheckoutId String?        @unique @map("asaas_checkout_id")
  status          CheckoutStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([status])
  @@map("checkouts")
}

model Payment {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  asaasPaymentId      String    @unique @map("asaas_payment_id")
  asaasSubscriptionId String?   @map("asaas_subscription_id")
  status              String
  billingType         String?   @map("billing_type")
  value               Decimal   @db.Decimal(12, 2)
  dueDate             DateTime? @map("due_date")
  paymentDate         DateTime? @map("payment_date")
  invoiceUrl          String?   @map("invoice_url")
  rawPayload          Json      @map("raw_payload")
  createdAt           DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("payments")
}

model Machine {
  id                      String      @id @default(uuid()) @db.Uuid
  companyId               String      @map("company_id") @db.Uuid
  name                    String
  type                    MachineType
  printVolumeXmm          Decimal     @map("print_volume_x_mm") @db.Decimal(10, 2)
  printVolumeYmm          Decimal     @map("print_volume_y_mm") @db.Decimal(10, 2)
  printVolumeZmm          Decimal     @map("print_volume_z_mm") @db.Decimal(10, 2)
  price                   Decimal     @default(0) @map("price") @db.Decimal(10, 2)
  depreciationCostPerHour Decimal     @map("depreciation_cost_per_hour") @db.Decimal(10, 4)
  maintenanceCostPerHour  Decimal     @default(0) @map("maintenance_cost_per_hour") @db.Decimal(10, 4)
  powerConsumptionKw      Decimal     @map("power_consumption_kw") @db.Decimal(10, 4)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  printItems PrintItem[]

  @@index([companyId])
  @@index([type])
  @@map("machines")
}

// Catálogo de referência (não pertence a nenhuma empresa) usado só para
// autocompletar o cadastro de máquina — nunca é escrito pelo usuário.
model MachineCatalog {
  id                      String      @id @default(uuid()) @db.Uuid
  brand                   String
  name                    String
  type                    MachineType
  price                   Decimal     @db.Decimal(10, 2)
  powerConsumptionWatts   Decimal     @map("power_consumption_watts") @db.Decimal(10, 2)
  printVolumeXmm          Decimal     @map("print_volume_x_mm") @db.Decimal(10, 2)
  printVolumeYmm          Decimal     @map("print_volume_y_mm") @db.Decimal(10, 2)
  printVolumeZmm          Decimal     @map("print_volume_z_mm") @db.Decimal(10, 2)
  depreciationCostPerHour Decimal     @map("depreciation_cost_per_hour") @db.Decimal(10, 4)
  maintenanceCostPerHour  Decimal     @map("maintenance_cost_per_hour") @db.Decimal(10, 4)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  @@unique([brand, name])
  @@index([name])
  @@map("machine_catalog")
}

model Material {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  brand            String
  type             MaterialType
  color            String
  totalWeightGrams Decimal      @map("total_weight_grams") @db.Decimal(10, 2)
  costPerGram      Decimal      @map("cost_per_gram") @db.Decimal(10, 6)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  printItems PrintItem[]

  @@index([companyId])
  @@index([type])
  @@map("materials")
}

model PricingSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  desiredMarginPercent Decimal  @default(30) @map("desired_margin_percent") @db.Decimal(7, 4)
  paintingHourRate     Decimal  @default(0) @map("painting_hour_rate") @db.Decimal(10, 2)
  finishingHourRate    Decimal  @default(0) @map("finishing_hour_rate") @db.Decimal(10, 2)
  errorRate            Decimal  @default(0) @map("error_rate") @db.Decimal(10, 4)
  extraFees            Json     @default("{}") @map("extra_fees")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pricing_settings")
}

model Formula {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  code         String
  name         String
  expression   String
  coefficients Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes  Quote[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@index([companyId, isDefault])
  @@map("formulas")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  formulaId        String?     @map("formula_id") @db.Uuid
  customerName     String      @map("customer_name")
  status           QuoteStatus @default(DRAFT)
  totalAmount      Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  totalPrintHours  Decimal     @default(0) @map("total_print_hours") @db.Decimal(10, 2)
  totalWeightGrams Decimal     @default(0) @map("total_weight_grams") @db.Decimal(10, 2)
  paintingHours    Decimal     @default(0) @map("painting_hours") @db.Decimal(10, 2)
  finishingHours   Decimal     @default(0) @map("finishing_hours") @db.Decimal(10, 2)
  validUntil       DateTime    @map("valid_until")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formula    Formula?    @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  printItems PrintItem[]

  @@index([companyId])
  @@index([formulaId])
  @@index([status])
  @@index([companyId, status])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@map("quotes")
}

model PrintItem {
  id                              String   @id @default(uuid()) @db.Uuid
  quoteId                         String   @map("quote_id") @db.Uuid
  machineId                       String   @map("machine_id") @db.Uuid
  materialId                      String   @map("material_id") @db.Uuid
  modelName                       String   @map("model_name")
  estimatedPrintTimeHours         Decimal  @map("estimated_print_time_hours") @db.Decimal(10, 2)
  materialWeightGrams             Decimal  @map("material_weight_grams") @db.Decimal(10, 2)
  calculatedCost                  Decimal  @default(0) @map("calculated_cost") @db.Decimal(12, 2)
  materialCost                    Decimal  @default(0) @map("material_cost") @db.Decimal(12, 2)
  energyCost                      Decimal  @default(0) @map("energy_cost") @db.Decimal(12, 2)
  depreciationCost                Decimal  @default(0) @map("depreciation_cost") @db.Decimal(12, 2)
  maintenanceCost                 Decimal  @default(0) @map("maintenance_cost") @db.Decimal(12, 2)
  baseCost                        Decimal  @default(0) @map("base_cost") @db.Decimal(12, 2)
  marginAmount                    Decimal  @default(0) @map("margin_amount") @db.Decimal(12, 2)
  feesTotal                       Decimal  @default(0) @map("fees_total") @db.Decimal(12, 2)
  finalPrice                      Decimal  @default(0) @map("final_price") @db.Decimal(12, 2)
  appliedMarginPercent            Decimal  @default(0) @map("applied_margin_percent") @db.Decimal(7, 4)
  appliedEnergyCostPerKwh         Decimal  @default(0) @map("applied_energy_cost_per_kwh") @db.Decimal(10, 4)
  appliedCardFeePercent           Decimal  @default(0) @map("applied_card_fee_percent") @db.Decimal(7, 4)
  appliedAdministrativeFeePercent Decimal  @default(0) @map("applied_administrative_fee_percent") @db.Decimal(7, 4)
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  quote    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  machine  Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([machineId])
  @@index([materialId])
  @@index([machineId, createdAt])
  @@index([materialId, createdAt])
  @@map("print_items")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  companyId    String?  @map("company_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  before       Json?
  after        Json?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemError {
  id         String   @id @default(uuid()) @db.Uuid
  message    String
  stack      String?
  code       String?
  severity   String   @default("error")
  method     String?
  path       String?
  statusCode Int?     @map("status_code")
  userId     String?  @map("user_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([code])
  @@map("system_errors")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  subject     String
  bodyHtml    String   @map("body_html") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model EmailLog {
  id              String   @id @default(uuid()) @db.Uuid
  templateKey     String   @map("template_key")
  toEmail         String   @map("to_email")
  subject         String
  status          String
  resendMessageId String?  @map("resend_message_id")
  errorMessage    String?  @map("error_message")
  dedupeKey       String?  @unique @map("dedupe_key")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([templateKey, toEmail])
  @@map("email_logs")
}
