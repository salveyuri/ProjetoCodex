generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CheckoutStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

// RECURRING: the discounted value stays the Asaas subscription's fixed
// recurring charge forever (today's default — see Coupon model comment).
// ONE_TIME: discounted only for the first billing cycle — once the webhook
// confirms that first payment, the subscription's value is pushed back to
// the plan's full price for every cycle after (see webhook.controller.ts /
// asaas.service.ts#revertSubscriptionToFullPrice).
enum CouponType {
  RECURRING
  ONE_TIME
}

enum MachineType {
  FDM
  RESIN
}

enum MaterialType {
  FILAMENT
  RESIN
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

// Null means no adjustment (the default) — see Quote.adjustmentType.
enum QuoteAdjustmentType {
  DISCOUNT
  SURCHARGE
}

model User {
  id                    String   @id @default(uuid()) @db.Uuid
  email                 String   @unique
  passwordHash          String   @map("password_hash")
  name                  String?
  role                  UserRole @default(USER)
  isActive              Boolean  @default(true) @map("is_active")
  notifyFinancialEmails Boolean  @default(true) @map("notify_financial_emails")
  notifyQuoteEmails     Boolean  @default(true) @map("notify_quote_emails")
  notifyNewsletter      Boolean  @default(false) @map("notify_newsletter")
  // "pt-BR" | "en" — see SupportedLanguage in shared/src/index.ts. Free-text
  // column (not a Prisma enum) so adding a language never needs a migration
  // touching this column's type, only a new EmailTemplate/dictionary set.
  language              String   @default("pt-BR")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company             Company?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @map("family_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdByIp         String?   @map("created_by_ip")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Company {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  name                  String
  logoUrl               String?            @map("logo_url")
  // ISO 3166-1 alpha-2. Drives defaultCurrency (BR -> BRL, else -> USD) —
  // set together in auth.service.ts, never edited independently.
  country               String             @default("BR")
  defaultCurrency       String             @default("BRL") @map("default_currency")
  taxRate               Decimal            @default(0) @map("tax_rate") @db.Decimal(7, 4)
  // Free-text business info shown on the quote PDF header — CNPJ/CPF,
  // phone, address. All optional, editable in Settings > Perfil.
  taxId                 String?            @map("tax_id")
  phone                 String?
  address               String?
  // Overrides the PDF's default localized terms/warranty text when set
  // (raw multi-line text, one term per line — see quote-pdf.service.ts).
  // Null keeps the built-in pt-BR/en defaults for everyone who never
  // touches this. Each language field only overrides that language's PDF —
  // customTerms alone set does NOT leak into an English PDF, it falls back
  // to the standard English terms instead (see resolveTerms()).
  customTerms           String?            @map("custom_terms") @db.Text
  customTermsEn         String?            @map("custom_terms_en") @db.Text
  planId                String             @map("plan_id") @db.Uuid
  subscriptionStatus    SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  asaasCustomerId       String?            @map("asaas_customer_id")
  asaasSubscriptionId   String?            @map("asaas_subscription_id")
  // The coupon (if any) currently discounting this subscription's recurring
  // charge — set once the webhook confirms the checkout that used it (same
  // moment planId itself is committed), cleared/replaced by a later
  // checkout with a different coupon or none. Display only: the discount
  // is already baked into what Asaas actually charges every cycle, this
  // column doesn't drive any calculation on our side.
  couponId              String?            @map("coupon_id") @db.Uuid
  currentQuotesCount    Int                @default(0) @map("current_quotes_count")
  quoteUsagePeriodStart DateTime           @default(now()) @map("quote_usage_period_start")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  machines        Machine[]
  materials       Material[]
  pricingSettings PricingSettings?
  formulas        Formula[]
  quotes          Quote[]
  checkouts       Checkout[]
  payments        Payment[]

  @@index([planId])
  @@index([subscriptionStatus])
  @@index([planId, subscriptionStatus])
  @@map("companies")
}

model Plan {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  name                String
  description         String?
  price               Decimal      @default(0) @map("price") @db.Decimal(10, 2)
  // Reference price shown to non-Brazil companies (display only — Asaas
  // has no currency parameter, the real charge always uses `price`/BRL).
  // Null until an admin fills it in on /admin/plans.
  priceUsd            Decimal?     @map("price_usd") @db.Decimal(10, 2)
  currency            String       @default("BRL")
  billingCycle        BillingCycle @default(MONTHLY) @map("billing_cycle")
  maxMachinesAllowed  Int?         @map("max_machines_allowed")
  maxMaterialsAllowed Int?         @map("max_materials_allowed")
  maxQuotesPerMonth   Int?         @map("max_quotes_per_month")
  features            Json         @default("{\"customFormulas\":false,\"pdfExport\":false}")
  isActive            Boolean      @default(true) @map("is_active")
  isPublic            Boolean      @default(true) @map("is_public")
  displayOrder        Int          @default(0) @map("display_order")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  companies Company[]
  checkouts Checkout[]

  @@index([isActive, isPublic])
  @@map("plans")
}

model Checkout {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  planId          String         @map("plan_id") @db.Uuid
  // Which coupon (if any) discounted this checkout's recurring value —
  // propagated to Company.couponId once the webhook confirms the first
  // payment (see webhook.controller.ts), same moment planId is committed.
  couponId        String?        @map("coupon_id") @db.Uuid
  asaasCheckoutId String?        @unique @map("asaas_checkout_id")
  status          CheckoutStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon  Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("checkouts")
}

// Admin-managed discount codes for subscription checkout (/admin/coupons).
// discountPercent is only ever read at checkout time to compute the item
// value Asaas charges — see asaas.service.ts. For a RECURRING coupon, once
// a subscription is created with that discounted value, Asaas itself keeps
// charging the same fixed amount every renewal cycle (no per-cycle
// reapplication needed). For a ONE_TIME coupon, the discount only covers
// that first charge — see CouponType. Company.couponId just records which
// coupon is currently attached, for display. Ver Contextos/Decisoes.md
// (2026-08-22, atualizado 2026-08-22 com o tipo ONE_TIME).
model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  discountPercent Decimal    @map("discount_percent") @db.Decimal(5, 2)
  type            CouponType @default(RECURRING)
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  checkouts Checkout[]
  companies Company[]

  @@map("coupons")
}

model Payment {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  asaasPaymentId      String    @unique @map("asaas_payment_id")
  asaasSubscriptionId String?   @map("asaas_subscription_id")
  status              String
  billingType         String?   @map("billing_type")
  value               Decimal   @db.Decimal(12, 2)
  dueDate             DateTime? @map("due_date")
  paymentDate         DateTime? @map("payment_date")
  invoiceUrl          String?   @map("invoice_url")
  rawPayload          Json      @map("raw_payload")
  createdAt           DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("payments")
}

model Machine {
  id                      String      @id @default(uuid()) @db.Uuid
  companyId               String      @map("company_id") @db.Uuid
  name                    String
  type                    MachineType
  printVolumeXmm          Decimal     @map("print_volume_x_mm") @db.Decimal(10, 2)
  printVolumeYmm          Decimal     @map("print_volume_y_mm") @db.Decimal(10, 2)
  printVolumeZmm          Decimal     @map("print_volume_z_mm") @db.Decimal(10, 2)
  price                   Decimal     @default(0) @map("price") @db.Decimal(10, 2)
  depreciationCostPerHour Decimal     @map("depreciation_cost_per_hour") @db.Decimal(10, 4)
  maintenanceCostPerHour  Decimal     @default(0) @map("maintenance_cost_per_hour") @db.Decimal(10, 4)
  powerConsumptionKw      Decimal     @map("power_consumption_kw") @db.Decimal(10, 4)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  printItems PrintItem[]

  @@index([companyId])
  @@index([type])
  @@map("machines")
}

// Catálogo de referência (não pertence a nenhuma empresa) usado só para
// autocompletar o cadastro de máquina — nunca é escrito pelo usuário.
model MachineCatalog {
  id                      String      @id @default(uuid()) @db.Uuid
  brand                   String
  name                    String
  type                    MachineType
  price                   Decimal     @db.Decimal(10, 2)
  powerConsumptionWatts   Decimal     @map("power_consumption_watts") @db.Decimal(10, 2)
  printVolumeXmm          Decimal     @map("print_volume_x_mm") @db.Decimal(10, 2)
  printVolumeYmm          Decimal     @map("print_volume_y_mm") @db.Decimal(10, 2)
  printVolumeZmm          Decimal     @map("print_volume_z_mm") @db.Decimal(10, 2)
  depreciationCostPerHour Decimal     @map("depreciation_cost_per_hour") @db.Decimal(10, 4)
  maintenanceCostPerHour  Decimal     @map("maintenance_cost_per_hour") @db.Decimal(10, 4)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  @@unique([brand, name])
  @@index([name])
  @@map("machine_catalog")
}

model Material {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  brand            String
  type             MaterialType
  color            String
  totalWeightGrams Decimal      @map("total_weight_grams") @db.Decimal(10, 2)
  costPerGram      Decimal      @map("cost_per_gram") @db.Decimal(10, 6)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  printItems PrintItem[]

  @@index([companyId])
  @@index([type])
  @@map("materials")
}

model PricingSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  desiredMarginPercent Decimal  @default(30) @map("desired_margin_percent") @db.Decimal(7, 4)
  paintingHourRate     Decimal  @default(0) @map("painting_hour_rate") @db.Decimal(10, 2)
  finishingHourRate    Decimal  @default(0) @map("finishing_hour_rate") @db.Decimal(10, 2)
  errorRate            Decimal  @default(0) @map("error_rate") @db.Decimal(10, 4)
  extraFees            Json     @default("{}") @map("extra_fees")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pricing_settings")
}

model Formula {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  code         String
  name         String
  expression   String
  coefficients Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes  Quote[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@index([companyId, isDefault])
  @@map("formulas")
}

// Global, admin-managed formulas. Visible read-only to every company (merged
// into their formula list) but never editable/deletable by them - only via
// the admin screen. Replaces the old per-company mutable copy of "the
// system default" (see Contextos/Decisoes.md, 2026-08-17).
model SystemFormula {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  expression String
  isActive   Boolean  @default(true) @map("is_active")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  quotes Quote[]

  @@map("system_formulas")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  formulaId        String?     @map("formula_id") @db.Uuid
  // Mutuamente exclusivo com formulaId - exatamente um dos dois é
  // preenchido (ou nenhum, se a fórmula usada foi só o fallback
  // hardcoded SYSTEM_DEFAULT_FORMULA, caso raríssimo de bootstrap sem
  // nenhuma linha em system_formulas). Existe pra persistir qual fórmula
  // do sistema (não editável pela empresa) foi selecionada - sem essa
  // coluna, selecionar uma fórmula do sistema num orçamento "esquecia"
  // qual era ao reabrir pra editar (voltava pra padrão). Ver
  // Contextos/Decisoes.md (2026-08-20).
  systemFormulaId  String?     @map("system_formula_id") @db.Uuid
  customerName     String      @map("customer_name")
  status           QuoteStatus @default(DRAFT)
  totalAmount      Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  totalPrintHours  Decimal     @default(0) @map("total_print_hours") @db.Decimal(10, 2)
  totalWeightGrams Decimal     @default(0) @map("total_weight_grams") @db.Decimal(10, 2)
  paintingHours    Decimal     @default(0) @map("painting_hours") @db.Decimal(10, 2)
  finishingHours   Decimal     @default(0) @map("finishing_hours") @db.Decimal(10, 2)
  // Se marcado, a taxa de cartão (Settings.cardFeePercent) é somada por
  // cima do preço que a fórmula calculou - cardFeeAmount é o valor em
  // dinheiro (snapshot, não recalculado se a taxa mudar depois) que essa
  // marcação realmente acrescentou, já incluído em totalAmount. Ver
  // Contextos/Decisoes.md (2026-08-21).
  cardPayment      Boolean     @default(false) @map("card_payment")
  cardFeeAmount    Decimal     @default(0) @map("card_fee_amount") @db.Decimal(12, 2)
  // "Desconto/Acréscimo" — null means neither is applied. Percent is what
  // the user typed; amount is the real snapshot (signed: negative for
  // DISCOUNT, positive for SURCHARGE) applied on top of totalAmount at
  // save time, same pattern as cardPayment/cardFeeAmount above. Ver
  // Contextos/Decisoes.md (2026-08-22).
  adjustmentType    QuoteAdjustmentType? @map("adjustment_type")
  adjustmentPercent Decimal              @default(0) @map("adjustment_percent") @db.Decimal(5, 2)
  adjustmentAmount  Decimal              @default(0) @map("adjustment_amount") @db.Decimal(12, 2)
  validUntil       DateTime    @map("valid_until")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formula       Formula?       @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  systemFormula SystemFormula? @relation(fields: [systemFormulaId], references: [id], onDelete: SetNull)
  printItems    PrintItem[]

  @@index([companyId])
  @@index([formulaId])
  @@index([systemFormulaId])
  @@index([status])
  @@index([companyId, status])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@map("quotes")
}

model PrintItem {
  id                              String   @id @default(uuid()) @db.Uuid
  quoteId                         String   @map("quote_id") @db.Uuid
  machineId                       String   @map("machine_id") @db.Uuid
  materialId                      String   @map("material_id") @db.Uuid
  modelName                       String   @map("model_name")
  estimatedPrintTimeHours         Decimal  @map("estimated_print_time_hours") @db.Decimal(10, 2)
  materialWeightGrams             Decimal  @map("material_weight_grams") @db.Decimal(10, 2)
  calculatedCost                  Decimal  @default(0) @map("calculated_cost") @db.Decimal(12, 2)
  materialCost                    Decimal  @default(0) @map("material_cost") @db.Decimal(12, 2)
  energyCost                      Decimal  @default(0) @map("energy_cost") @db.Decimal(12, 2)
  depreciationCost                Decimal  @default(0) @map("depreciation_cost") @db.Decimal(12, 2)
  maintenanceCost                 Decimal  @default(0) @map("maintenance_cost") @db.Decimal(12, 2)
  baseCost                        Decimal  @default(0) @map("base_cost") @db.Decimal(12, 2)
  marginAmount                    Decimal  @default(0) @map("margin_amount") @db.Decimal(12, 2)
  feesTotal                       Decimal  @default(0) @map("fees_total") @db.Decimal(12, 2)
  finalPrice                      Decimal  @default(0) @map("final_price") @db.Decimal(12, 2)
  appliedMarginPercent            Decimal  @default(0) @map("applied_margin_percent") @db.Decimal(7, 4)
  appliedEnergyCostPerKwh         Decimal  @default(0) @map("applied_energy_cost_per_kwh") @db.Decimal(10, 4)
  appliedCardFeePercent           Decimal  @default(0) @map("applied_card_fee_percent") @db.Decimal(7, 4)
  appliedAdministrativeFeePercent Decimal  @default(0) @map("applied_administrative_fee_percent") @db.Decimal(7, 4)
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  quote    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  machine  Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([machineId])
  @@index([materialId])
  @@index([machineId, createdAt])
  @@index([materialId, createdAt])
  @@map("print_items")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  companyId    String?  @map("company_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  before       Json?
  after        Json?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemError {
  id         String   @id @default(uuid()) @db.Uuid
  message    String
  stack      String?
  code       String?
  severity   String   @default("error")
  method     String?
  path       String?
  statusCode Int?     @map("status_code")
  userId     String?  @map("user_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([code])
  @@map("system_errors")
}

// One row per (key, language) — each of the 6 triggers has both a pt-BR
// and an en variant, selected at send time by the recipient's User.language.
model EmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  language    String   @default("pt-BR")
  name        String
  description String?
  subject     String
  bodyHtml    String   @map("body_html") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([key, language])
  @@map("email_templates")
}

model EmailLog {
  id              String   @id @default(uuid()) @db.Uuid
  templateKey     String   @map("template_key")
  toEmail         String   @map("to_email")
  subject         String
  status          String
  resendMessageId String?  @map("resend_message_id")
  errorMessage    String?  @map("error_message")
  dedupeKey       String?  @unique @map("dedupe_key")
  createdAt       DateTime @default(now()) @map("created_at")

  // Exact HTML actually sent (after variable substitution — the real reset
  // link, the real customer name, etc.), not just the subject. Lets an
  // admin re-read what a specific customer was sent (e.g. a password reset
  // link) straight from the log — see /admin/email-templates' preview
  // modal. Null for rows written before this column existed, and for
  // SKIPPED_INACTIVE (nothing was ever rendered).
  bodyHtml String? @map("body_html") @db.Text

  // Filled in asynchronously by the Resend webhook (POST
  // /api/webhooks/resend) once Resend's own delivery attempt resolves —
  // `status`/`resendMessageId` above only reflect that Resend's *API*
  // accepted the send request, not that the message actually reached the
  // recipient's mail server. Null until (if ever) a webhook event arrives
  // for this message.
  deliveryStatus    String?   @map("delivery_status")
  deliveryDetail    String?   @map("delivery_detail")
  deliveryPayload   Json?     @map("delivery_payload")
  deliveryUpdatedAt DateTime? @map("delivery_updated_at")

  // True only for sends triggered by the "Testar e-mail" button
  // (EmailService.sendTest) — every real trigger (account created,
  // password reset, subscription events, quote summary) leaves this
  // false. Test rows are purged 48h after creation by
  // jobs/email-log-cleanup.job.ts; real rows are never auto-deleted.
  isTest Boolean @default(false) @map("is_test")

  @@index([templateKey, toEmail])
  @@index([resendMessageId])
  @@index([isTest, createdAt])
  @@map("email_logs")
}
