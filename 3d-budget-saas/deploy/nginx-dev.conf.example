# Reference reverse-proxy config for the DEV/STAGING stack (docker-compose.dev.yml)
# — same shape as deploy/nginx.conf.example, just pointed at the dev
# ports and a different hostname so it can run alongside production on
# the same VPS without conflict. See Contextos/Ambientes.md ("Ambiente de
# dev/staging").
#
# WHAT THIS DOES:
#   - Routes /api/* to the dev backend (host port 3011).
#   - Routes everything else to the dev frontend (host port 3010).
#   - No TLS — same as the production example, terminate with Certbot:
#       certbot --nginx -d dev.pricify3d.com

server {
    listen 80;
    server_name dev.pricify3d.com;

    location /api/ {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
